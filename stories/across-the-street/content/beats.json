  "chapters": [
    {
      "id": "sunday-morning",
      "title": "Sunday Morning",
      "beats": [
        { "id": "sm-01", "source": [ 0 ], "kind": "prose", "lines": [ "The sun came up", "over the buildings opposite", "and laid a long block", "of warm light", "across Marcus's living room." ] },
        { "id": "sm-02", "source": [ 0 ], "kind": "prose", "lines": [ "The sofa. The coffee table.", "The plant by the window.", "And finally, the rug." ] },
        { "id": "sm-03", "source": [ 1 ], "kind": "prose", "lines": [ "The rug was new.", "Two weeks choosing it.", "More money than", "he had meant to spend." ] },
        { "id": "sm-04", "source": [ 1 ], "kind": "prose", "lines": [ "Every morning since,", "he crossed it barefoot", "and felt a small,", "private pleasure." ] },
        { "id": "sm-05", "source": [ 2 ], "kind": "prose", "lines": [ "Today he made eggs.", "Slowly, low heat,", "off before they looked done.", "Strawberries in a white bowl,", "washed and halved." ] },
        { "id": "sm-06", "source": [ 3 ], "kind": "prose", "lines": [ "He started that after Lisbon.", "Alone in a café,", "strawberries on the next table", "beside two pieces of toast.", "Nothing remarkable." ] },
        { "id": "sm-07", "source": [ 3, 4 ], "kind": "thought", "breathe": true, "lines": [ "But he remembered thinking:", "*People live like this.*" ] },
        { "id": "sm-08", "source": [ 5 ], "kind": "prose", "lines": [ "For years, Marcus believed", "some people knew", "how to live.", "Others simply", "got through the day." ] },
        { "id": "sm-09", "source": [ 5 ], "kind": "prose", "lines": [ "People who bought", "flowers for themselves.", "Who travelled alone.", "Who cut strawberries in half", "on a Sunday morning." ] },
        { "id": "sm-10", "source": [ 6 ], "kind": "prose", "breathe": true, "lines": [ "Now, apparently,", "he was one of them." ] },
        { "id": "sm-11", "source": [ 7 ], "kind": "prose", "lines": [ "By the front door,", "a board he put up", "in March." ] },
        { "id": "sm-12", "source": [ 7 ], "kind": "prose", "lines": [ "A tram pass from Prague.", "A wristband from Berlin.", "A table by the sea.", "A postcard from Sintra,", "bought and never sent." ], "hint": "drag" },
        { "id": "sm-13", "source": [ 8 ], "kind": "prose", "lines": [ "Two hours arranging it.", "Moving things half an inch.", "Stepping back.", "Moving them again." ] },
        { "id": "sm-14", "source": [ 9, 10 ], "kind": "prose", "breathe": true, "lines": [ "No one was coming over.", "No one would have noticed", "if it was crooked.", "That had been the point." ] },
        { "id": "sm-15", "source": [ 11 ], "kind": "prose", "lines": [ "From the table,", "leaning toward the window,", "he could see", "where he used to live,", "above a shuttered bank." ] },
        { "id": "sm-16", "source": [ 12 ], "kind": "prose", "breathe": true, "lines": [ "Third floor.", "Second window from the left." ] },
        { "id": "sm-17", "source": [ 13 ], "kind": "prose", "lines": [ "Three years there.", "Water through the ceiling.", "A kitchen window", "that never shut,", "a towel in the gap." ] },
        { "id": "sm-18", "source": [ 13 ], "kind": "prose", "lines": [ "Damp above the bed", "that kept coming back,", "however many times", "they painted over it." ] },
        { "id": "sm-19", "source": [ 14 ], "kind": "prose", "lines": [ "For three years he said", "he was going to leave.", "When work settled down.", "When he had saved more.", "When things were", "less complicated." ] },
        { "id": "sm-20", "source": [ 15 ], "kind": "prose", "lines": [ "Then one Tuesday,", "for no dramatic reason,", "he called three estate agents.", "A month later, a van.", "The move took four hours." ] },
        { "id": "sm-21", "source": [ 16 ], "kind": "prose", "lines": [ "Barely forty metres away.", "For three years,", "another life had been waiting", "across the road." ] },
        { "id": "sm-22", "source": [ 17 ], "kind": "prose", "lines": [ "Running in the mornings.", "Buying the stupid rug.", "Calling people back.", "Leaving parties", "when he wanted to leave." ] },
        { "id": "sm-23", "source": [ 18, 19 ], "kind": "prose", "breathe": true, "lines": [ "None of it", "had happened to him.", "He had done it.", "That was the part", "he still wasn't used to." ] },
        { "id": "sm-24", "source": [ 20 ], "kind": "prose", "lines": [ "He poured coffee", "and went to the window.", "The street below", "was doing its Sunday things." ] },
        { "id": "sm-25", "source": [ 20 ], "kind": "prose", "lines": [ "A fruit seller", "setting out crates.", "Two boys, slow on bicycles.", "A woman and a dog", "that had decided", "the walk was over." ] },
        { "id": "sm-26", "source": [ 21 ], "kind": "prose", "lines": [ "Outside the shuttered bank,", "beneath his old", "kitchen window,", "a man was shouting", "into a phone." ] }
      ]
    },
    {
      "id": "across-the-street",
      "title": "Across the Street",
      "beats": [
        { "id": "as-01", "source": [ 0, 1 ], "kind": "prose", "lines": [ "Marcus watched him.", "A long dark coat", "despite the warmth.", "One hand on the phone,", "the other cutting the air." ] },
        { "id": "as-02", "source": [ 1 ], "kind": "prose", "lines": [ "Three steps one way.", "Three steps back.", "Never leaving the pavement", "in front of the bank." ] },
        { "id": "as-03", "source": [ 2 ], "kind": "prose", "lines": [ "The shoulders raised too high.", "The jaw held tight.", "Whatever had happened", "had already happened.", "His body had not", "yet been told." ] },
        { "id": "as-04", "source": [ 3 ], "kind": "prose", "lines": [ "Marcus knew that posture.", "Outside pubs. At bus stops.", "In the old kitchen", "at two in the morning." ] },
        { "id": "as-05", "source": [ 3 ], "kind": "prose", "lines": [ "Explaining. Defending.", "Rehearsing arguments", "before they happened,", "continuing them", "long after they were over." ] },
        { "id": "as-06", "source": [ 4 ], "kind": "prose", "lines": [ "He looked past the man", "to the window above him.", "His old window." ] },
        { "id": "as-07", "source": [ 5, 6 ], "kind": "prose", "breathe": true, "lines": [ "For a second,", "he saw himself behind it.", "The shape of someone", "awake too late.", "Then the feeling passed." ] },
        { "id": "as-08", "source": [ 7 ], "kind": "prose", "lines": [ "The sunlight. The table.", "The bowl of strawberries.", "The board. The rug.", "Everything exactly", "where he had put it." ] },
        { "id": "as-09", "source": [ 8, 9 ], "kind": "prose", "lines": [ "And yet,", "for one strange second,", "none of it looked secure.", "The thought came quietly." ] },
        { "id": "as-10", "source": [ 10 ], "kind": "thought", "breathe": true, "hint": "tap", "lines": [ "*What if I ruin*", "*all of this?*" ] },
        { "id": "as-11", "source": [ 11 ], "kind": "prose", "lines": [ "His hand jerked.", "The mug slipped.", "It struck the floor,", "rolled once,", "and emptied itself", "across the rug." ] },
        { "id": "as-12", "source": [ 12 ], "kind": "prose", "lines": [ "Marcus stared.", "The coffee spread", "through the wool.", "He set the mug upright.", "Nothing left in it." ] },
        { "id": "as-13", "source": [ 13 ], "kind": "prose", "lines": [ "Below, the fruit seller", "glanced up at the sound.", "The boy on the bicycle", "followed his gaze." ] },
        { "id": "as-14", "source": [ 14 ], "kind": "prose", "lines": [ "Marcus stepped back.", "Four floors up,", "standing over the thing", "he had ruined,", "certain it was visible", "from the street." ] },
        { "id": "as-15", "source": [ 15 ], "kind": "prose", "lines": [ "Across the road,", "the man lowered his phone.", "He looked directly", "at Marcus." ] },
        { "id": "as-16", "source": [ 16 ], "kind": "prose", "breathe": true, "lines": [ "Then he started walking", "toward the building." ] }
      ]
    },
    {
      "id": "the-knock",
      "title": "The Knock",
      "beats": [
        { "id": "kn-01", "source": [ 0 ], "kind": "prose", "lines": [ "The knock came", "before Marcus had decided", "what to do", "about the stain.", "Two heavy blows." ] },
        { "id": "kn-02", "source": [ 1 ], "kind": "prose", "hint": "tap", "lines": [ "He stood still.", "Another knock." ] },
        { "id": "kn-03", "source": [ 2 ], "kind": "prose", "lines": [ "Marcus opened it." ] },
        { "id": "kn-04", "source": [ 3 ], "kind": "prose", "lines": [ "The man from the street", "walked past him, uninvited.", "Not aggressively.", "Almost familiarly,", "as though he had", "been there before." ] },
        { "id": "kn-05", "source": [ 4 ], "kind": "prose", "lines": [ "Up close, nothing remarkable.", "Roughly Marcus's age.", "Tired eyes. A day's growth", "along his jaw. The coat", "worn at the cuffs,", "slightly too large." ] },
        { "id": "kn-06", "source": [ 5, 6 ], "kind": "dialogue", "lines": [ "He stopped at the rug.", "For a moment, nothing.", "Then he looked at Marcus.", "“Look what you did.”" ] },
        { "id": "kn-07", "source": [ 7, 8 ], "kind": "dialogue", "lines": [ "Marcus glanced down.", "“It's coffee.”", "A short laugh.", "“Of course it is.”" ] },
        { "id": "kn-08", "source": [ 9, 10 ], "kind": "dialogue", "lines": [ "“I can clean it.”", "“Right.”" ] },
        { "id": "kn-09", "source": [ 11 ], "kind": "prose", "lines": [ "He walked farther in,", "taking in the room.", "The sofa. The lamp.", "The plant by the window.", "Breakfast on the table." ] },
        { "id": "kn-10", "source": [ 12, 13 ], "kind": "dialogue", "lines": [ "His eyes moved", "to the board.", "“What's this?”", "Marcus didn't answer." ] },
        { "id": "kn-11", "source": [ 14 ], "kind": "dialogue", "lines": [ "He touched the postcard", "from Sintra", "with one finger.", "“Two hours.”" ] },
        { "id": "kn-12", "source": [ 15, 16 ], "kind": "dialogue", "lines": [ "Something tightened in Marcus.", "“What?”", "“You spent two hours", "doing this.”" ] },
        { "id": "kn-13", "source": [ 17, 18 ], "kind": "dialogue", "lines": [ "The postcard looked", "slightly duller", "than a moment ago.", "Marcus frowned.", "“How do you know that?”" ] },
        { "id": "kn-14", "source": [ 19, 20 ], "kind": "dialogue", "lines": [ "“You measured the gaps.”", "He looked at him.", "“Spirit level and everything.”", "Marcus said nothing." ] },
        { "id": "kn-15", "source": [ 21 ], "kind": "dialogue", "lines": [ "He turned to the board.", "“A tram ticket. A postcard.", "A receipt from a bar.”", "His finger moved slowly", "across the wall.", "“Look at Marcus.”" ] },
        { "id": "kn-16", "source": [ 22, 23 ], "kind": "dialogue", "lines": [ "Something hot", "moved up Marcus's neck.", "“Don't touch it.”", "He pulled his hand away." ] },
        { "id": "kn-17", "source": [ 24 ], "kind": "prose", "lines": [ "For the first time,", "Marcus felt embarrassed by it.", "The stubs. The photographs.", "Evidence, arranged neatly", "on a wall." ] },
        { "id": "kn-18", "source": [ 25 ], "kind": "thought", "breathe": true, "lines": [ "*Look where I've been.*", "*Look who I am now.*" ] },
        { "id": "kn-19", "source": [ 26, 27, 28 ], "kind": "dialogue", "lines": [ "Behind him, quietly:", "“There you are.”", "Marcus turned. “What?”", "“There you are.”" ] },
        { "id": "kn-20", "source": [ 29 ], "kind": "prose", "breathe": true, "lines": [ "Marcus looked down.", "He had picked up", "a dishcloth.", "He hadn't noticed doing it." ] }
      ]
    },
    {
      "id": "the-stain",
      "title": "The Stain",
      "beats": [
        { "id": "st-01", "source": [ 0, 1 ], "kind": "dialogue", "hint": "scrub", "lines": [ "Marcus crouched by the rug", "and pressed the cloth", "into the coffee.", "Brown lifted into the fabric.", "“There,” he said." ] },
        { "id": "st-02", "source": [ 2, 3 ], "kind": "dialogue", "lines": [ "He rubbed harder.", "The stain spread.", "“No.”", "He folded the cloth.", "The coffee moved farther." ] },
        { "id": "st-03", "source": [ 4, 5, 6 ], "kind": "dialogue", "lines": [ "“Stop.”", "“I can get it out.”", "The man stood above him.", "“Marcus.”" ] },
        { "id": "st-04", "source": [ 7, 8 ], "kind": "dialogue", "lines": [ "He scrubbed.", "“I said", "I can get it out.”", "“Look at you.”" ] },
        { "id": "st-05", "source": [ 9 ], "kind": "prose", "lines": [ "Marcus stopped.", "The man's voice had changed.", "Not louder.", "Closer." ] },
        { "id": "st-06", "source": [ 10 ], "kind": "dialogue", "lines": [ "“On your knees", "on a Sunday morning", "because you spilled", "a cup of coffee.”" ] },
        { "id": "st-07", "source": [ 11, 12 ], "kind": "prose", "lines": [ "Marcus looked up.", "Through the open door,", "the hallway was wrong.", "A flat, dead beige." ] },
        { "id": "st-08", "source": [ 12 ], "kind": "prose", "lines": [ "A water stain", "on the ceiling.", "A wide brown mark,", "almost like a hand." ] },
        { "id": "st-09", "source": [ 13, 14 ], "kind": "prose", "lines": [ "Damp plaster.", "Old smoke from downstairs.", "Fabric that never quite dried.", "His stomach turned." ] },
        { "id": "st-10", "source": [ 15 ], "kind": "prose", "lines": [ "Marcus stood.", "The rug seemed cheaper.", "The room smaller.", "The board childish.", "The eggs had gone cold." ] },
        { "id": "st-11", "source": [ 16, 17 ], "kind": "prose", "breathe": true, "lines": [ "Of course.", "There it was." ] },
        { "id": "st-12", "source": [ 18, 19, 20 ], "kind": "dialogue", "lines": [ "He looked at the cloth.", "“I'll fix it.”", "No answer.", "He crouched again.", "“I can fix it.”" ] },
        { "id": "st-13", "source": [ 21, 22, 23, 24 ], "kind": "dialogue", "lines": [ "“Stop.”", "“I'm sorry.”", "“Don't.”", "The word came hard enough", "to stop his hand." ] },
        { "id": "st-14", "source": [ 25 ], "kind": "prose", "lines": [ "Marcus looked up.", "The man wasn't angry anymore.", "Or not only angry." ] },
        { "id": "st-15", "source": [ 26 ], "kind": "dialogue", "lines": [ "“Don't apologise to me.”" ] },
        { "id": "st-16", "source": [ 27, 28 ], "kind": "dialogue", "lines": [ "Breathing heavily.", "“Three years.”", "Marcus stayed still." ] },
        { "id": "st-17", "source": [ 29 ], "kind": "dialogue", "lines": [ "“Three years", "I kept us alive", "in that place.”", "He pointed toward the hallway." ] },
        { "id": "st-18", "source": [ 29 ], "kind": "dialogue", "lines": [ "“When nobody called back.", "When there was nothing", "in the account." ] },
        { "id": "st-19", "source": [ 29 ], "kind": "dialogue", "lines": [ "“When the ceiling came in", "over the bed", "and we slept", "on the floor", "because we couldn't afford", "anywhere else.”" ] },
        { "id": "st-20", "source": [ 30, 31 ], "kind": "dialogue", "lines": [ "Marcus loosened his grip.", "“I got us through", "every week.”" ] },
        { "id": "st-21", "source": [ 31 ], "kind": "dialogue", "lines": [ "He looked across the road.", "“I knew how", "to live there.”" ] },
        { "id": "st-22", "source": [ 31 ], "kind": "dialogue", "lines": [ "“I knew which sound", "in the wall meant water", "and which one was pipes.”" ] },
        { "id": "st-23", "source": [ 32, 33 ], "kind": "dialogue", "breathe": true, "lines": [ "He looked around the flat.", "“Then you just left.”" ] }
      ]
    },
    {
      "id": "the-phone",
      "title": "The Phone",
      "beats": [
        { "id": "ph-01", "source": [ 0, 1 ], "kind": "dialogue", "lines": [ "Marcus stood slowly.", "The man's voice thinned.", "“You packed a van", "and walked out.”" ] },
        { "id": "ph-02", "source": [ 2, 3 ], "kind": "dialogue", "lines": [ "Something in him went quiet.", "“You didn't take", "anything of mine.”" ] },
        { "id": "ph-03", "source": [ 4 ], "kind": "prose", "lines": [ "Then he noticed the phone,", "still in the man's hand." ] },
        { "id": "ph-04", "source": [ 5, 6, 7, 8 ], "kind": "dialogue", "hint": "tap", "lines": [ "“Who were you talking to?”", "“What?”", "“Outside.”", "No answer." ] },
        { "id": "ph-05", "source": [ 9, 10 ], "kind": "dialogue", "lines": [ "“You were shouting", "at someone.”", "The screen stayed dark.", "No call. No name.", "Nothing." ] },
        { "id": "ph-06", "source": [ 11, 12 ], "kind": "dialogue", "lines": [ "“There's nobody there,”", "Marcus said.", "“You don't know", "what you're talking about.”" ] },
        { "id": "ph-07", "source": [ 13, 14 ], "kind": "dialogue", "lines": [ "“Who were you talking to?”", "“Leave it.”" ] },
        { "id": "ph-08", "source": [ 15 ], "kind": "prose", "lines": [ "The raised shoulders.", "The coat hanging", "too heavily from them.", "The hand gripping", "a silent phone." ] },
        { "id": "ph-09", "source": [ 16, 17 ], "kind": "prose", "lines": [ "And something shifted.", "He looked smaller.", "Not harmless. Not yet.", "Just tired." ] },
        { "id": "ph-10", "source": [ 18, 19 ], "kind": "dialogue", "lines": [ "The hallway. The old window.", "Back to the man.", "“You don't know", "what to do", "when nothing's wrong.”" ] },
        { "id": "ph-11", "source": [ 20, 21 ], "kind": "prose", "breathe": true, "lines": [ "The man flinched.", "Only slightly.", "The room became very still." ] },
        { "id": "ph-12", "source": [ 22, 23 ], "kind": "dialogue", "lines": [ "His eyes landed", "on the strawberries.", "“Look at you,” he said.", "No mockery now.", "“Strawberries in a bowl.”" ] },
        { "id": "ph-13", "source": [ 24, 25 ], "kind": "dialogue", "lines": [ "Marcus almost smiled.", "“Lisbon.” The board.", "“Prague.” The rug.", "“This.”" ] },
        { "id": "ph-14", "source": [ 27, 28, 29, 30 ], "kind": "dialogue", "lines": [ "“You think", "you're better than me.”", "“No.”", "“You are.”", "“No.”" ] },
        { "id": "ph-15", "source": [ 31, 32, 33 ], "kind": "dialogue", "lines": [ "“You don't need me.”", "Marcus didn't answer", "quickly enough.", "“You'd be nothing", "without me.”" ] },
        { "id": "ph-16", "source": [ 34, 35 ], "kind": "dialogue", "lines": [ "Marcus looked at him.", "“You're right.”", "The man went still." ] },
        { "id": "ph-17", "source": [ 36, 38 ], "kind": "dialogue", "lines": [ "Marcus stepped closer.", "“You kept us alive.”", "“I mean it.”" ] },
        { "id": "ph-18", "source": [ 39 ], "kind": "prose", "lines": [ "Through the window,", "the old kitchen", "above the shuttered bank.", "He had hated that room.", "Now he remembered", "other things." ] },
        { "id": "ph-19", "source": [ 40 ], "kind": "prose", "lines": [ "Cereal over the sink.", "Laughing alone at 3 a.m.", "The email that gave him", "his first decent job." ] },
        { "id": "ph-20", "source": [ 40 ], "kind": "prose", "lines": [ "A saucepan catching rain.", "Calling his mother,", "telling her", "everything was fine." ] },
        { "id": "ph-21", "source": [ 41, 42 ], "kind": "prose", "breathe": true, "lines": [ "Someone had lived through it.", "Neither of them spoke." ] },
        { "id": "ph-22", "source": [ 43, 44, 45 ], "kind": "dialogue", "lines": [ "“You got us out.”", "“What?”", "“You got us here.”" ] },
        { "id": "ph-23", "source": [ 46 ], "kind": "prose", "lines": [ "The sunlight had reached", "almost across the rug.", "His face changed.", "Only a little.", "But enough." ] },
        { "id": "ph-24", "source": [ 47, 48 ], "kind": "dialogue", "lines": [ "“So what am I", "for now?”", "So quiet", "Marcus nearly missed it." ] },
        { "id": "ph-25", "source": [ 49, 50 ], "kind": "prose", "lines": [ "The coat. The tired eyes.", "The hand on the phone.", "He hadn't come", "to take the apartment.", "He had nowhere", "else to go." ] },
        { "id": "ph-26", "source": [ 51, 52 ], "kind": "prose", "lines": [ "Marcus crossed the space.", "The man's shoulders rose,", "as if expecting a blow.", "Marcus put a hand", "on his shoulder." ] },
        { "id": "ph-27", "source": [ 52, 53 ], "kind": "dialogue", "lines": [ "The coat was warm.", "Underneath, he was shaking.", "Marcus held on.", "“You got us here,”", "he said again." ] },
        { "id": "ph-28", "source": [ 54, 55 ], "kind": "dialogue", "breathe": true, "lines": [ "The man looked at him.", "“You can rest.”" ] },
        { "id": "ph-29", "source": [ 56 ], "kind": "prose", "lines": [ "His face folded.", "His eyes shut.", "His shoulders dropped.", "A long breath,", "the end of something longer." ] }
      ]
    },
    {
      "id": "the-window",
      "title": "The Window",
      "beats": [
        { "id": "wi-01", "source": [ 0 ], "kind": "prose", "lines": [ "They stood like that", "for a while." ] },
        { "id": "wi-02", "source": [ 1 ], "kind": "prose", "lines": [ "The man opened his eyes.", "He looked younger.", "Young enough", "that Marcus wondered", "how he had missed it." ] },
        { "id": "wi-03", "source": [ 2, 3 ], "kind": "dialogue", "lines": [ "“What if you go back?”", "Marcus looked at the stain.", "He wanted to say", "he wouldn't." ] },
        { "id": "wi-04", "source": [ 4, 5 ], "kind": "dialogue", "lines": [ "Instead he said,", "“Maybe I will.”", "The man stared at him." ] },
        { "id": "wi-05", "source": [ 6 ], "kind": "dialogue", "lines": [ "“For a day.", "For a week.", "I don't know.”", "The old window waited." ] },
        { "id": "wi-06", "source": [ 6 ], "kind": "dialogue", "lines": [ "“But going back", "doesn't mean I have", "to live there again.”" ] },
        { "id": "wi-07", "source": [ 7, 8 ], "kind": "prose", "hint": "hold", "lines": [ "Marcus's hand", "was still on his shoulder.", "Sunlight touched", "the edge of the coat.", "Dust turned in the beam." ] },
        { "id": "wi-08", "source": [ 9, 10 ], "kind": "prose", "lines": [ "Then Marcus realised", "it wasn't dust.", "The fabric beneath his hand", "had started to loosen.", "Not tear. Loosen." ] },
        { "id": "wi-09", "source": [ 11, 12 ], "kind": "prose", "lines": [ "Neither of them", "seemed surprised.", "His sleeve went next.", "Then his hand." ] },
        { "id": "wi-10", "source": [ 12, 13 ], "kind": "prose", "lines": [ "The coat became", "a cloud of tiny pieces,", "lifting into the sunlight.", "Marcus kept hold", "for as long as", "there was something to hold." ] },
        { "id": "wi-11", "source": [ 14 ], "kind": "prose", "lines": [ "The face went last.", "The tired eyes. The jaw.", "Just before it disappeared,", "he looked almost relieved." ] },
        { "id": "wi-12", "source": [ 15, 16 ], "kind": "prose", "breathe": true, "lines": [ "The phone slipped.", "It hit the floor", "without making a sound.", "Then it was gone too." ] }
      ]
    },
    {
      "id": "after",
      "title": "After",
      "beats": [
        { "id": "af-01", "source": [ 0 ], "kind": "prose", "lines": [ "The hallway was white again.", "Marcus stood alone.", "The strawberries were red.", "The postcard, a blue sea." ] },
        { "id": "af-02", "source": [ 1 ], "kind": "prose", "lines": [ "The stain was still there.", "Brown, uneven,", "the size of a saucer." ] },
        { "id": "af-03", "source": [ 2 ], "kind": "prose", "lines": [ "There were things", "you could buy for wool.", "Sprays. Powders.", "He could probably", "get most of it out." ] },
        { "id": "af-04", "source": [ 3 ], "kind": "prose", "lines": [ "He rinsed the mug.", "Poured another coffee.", "Went back to the window." ] },
        { "id": "af-05", "source": [ 4 ], "kind": "prose", "lines": [ "The street had gone", "back to itself.", "The fruit seller, arguing", "over the price of oranges.", "The boys gone.", "The dog had won." ] },
        { "id": "af-06", "source": [ 5 ], "kind": "prose", "lines": [ "Across the road,", "the pavement was empty.", "The old kitchen window", "caught the sun." ] },
        { "id": "af-07", "source": [ 6, 7 ], "kind": "prose", "lines": [ "Marcus drank his coffee.", "He knew the man", "would come back.", "Not tomorrow, necessarily." ] },
        { "id": "af-08", "source": [ 7 ], "kind": "prose", "lines": [ "Some morning", "the room would feel smaller.", "Money would get tight.", "A cup would fall." ] },
        { "id": "af-09", "source": [ 8 ], "kind": "prose", "lines": [ "And he would see", "the coat again,", "pacing beneath the old window,", "looking for someone to fight." ] },
        { "id": "af-10", "source": [ 9, 10 ], "kind": "prose", "breathe": true, "lines": [ "Next time,", "he would go downstairs.", "Sit beside him.", "Maybe say nothing.", "There was nothing to defeat." ] },
        { "id": "af-11", "source": [ 11 ], "kind": "prose", "lines": [ "Marcus turned from the window.", "The light had moved", "across the room.", "It reached the place", "where the coffee had dried." ] },
        { "id": "af-12", "source": [ 12, 13 ], "kind": "prose", "breathe": true, "lines": [ "He looked at the faint", "brown ring in the wool.", "Then he left it there." ] },
        { "id": "af-13", "source": [ 14 ], "kind": "prose", "lines": [ "So the man would know", "where to find him." ] }
      ]
    }
